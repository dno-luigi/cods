{
  "name": "cods",
  "main": "worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-03-24",
  // @cloudflare/puppeteer reaches for node:buffer, which the Worker runtime
  // only provides with the nodejs_compat flag.
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  // Headless Chromium for web search: a real page loads the results the way a
  // visitor would. Requires the Workers Paid plan; the search chain skips it
  // whenever this binding is absent, so removing it is always safe.
  "browser": {
    "binding": "BROWSER",
    // Quick Actions talk to the real Browser Run endpoint. Without this,
    // `wrangler dev` answers "The RPC receiver does not implement the method
    // quickAction", so local development drives the real thing.
    "remote": true
  },
  // Cards are written back to AI Search as notes.
  //   namespace: ai-inspired   instance: NSM   on env.mainspace
  // Namespaces must be lowercase (API code 7001), so no capitals here.
  "ai_search_namespaces": [
    {
      "binding": "mainspace",
      "namespace": "ai-inspired",
      "remote": true
    }
  ],
  // Memory, split by how long each piece is meant to last:
  //   CONTEXT  what the app knows about this person: learned preferences, decks, theme
  //   ARCHIVE  answers that were signed off, plus a log of what was asked
  //   CACHE    only the short-lived answer cache, so it can be emptied alone
  //   KV       the fallback for the cache, and what older answers live in
  //   LTM (R2) every answer, kept for good, so a repeat question outlives the cache TTL
  "kv_namespaces": [
    {
      "binding": "ARCHIVE",
      "id": "1904b566c36f4850ad0d084c781f3c39"
    },
    {
      "binding": "CACHE",
      "id": "b03416fb0fe547069d288cfb8ad49821"
    },
    {
      "binding": "CONTEXT",
      "id": "b78a25e9928e44b3ab0a3e9647a2ee33"
    },
    {
      "binding": "KV",
      "id": "4a9bfbffb4d440cba86badc508e2045a"
    },
    // The truth store and the audit trail: the namespaces the engine already
    // casts into, on the same account. Unbound, truths land in ARCHIVE under a
    // "truth:" prefix and still work; bound, they land where the master truths
    // live. Bindings take effect on the next deploy, not before.
    {
      "binding": "TRUTHS",
      "id": "904eff3af4c14f06964e4f651cce9573"
    },
    {
      "binding": "AUDITS",
      "id": "8c19918f71fd420d8115e022d3014b9f"
    }
  ],
  // TRUTHS and AUDITS are bound above. If a deploy ever fails because those
  // namespaces are not on this account, comment the two entries out and the
  // worker falls back to ARCHIVE: the code prefers TRUTHS, never requires it.
  "r2_buckets": [
    {
      "binding": "LTM",
      "bucket_name": "long-term-memory"
    }
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  // The OpenRouter proxy: the key and the model stay in that Worker, and cods
  // asks it for text at POST /api/generate. It prefixes the model with
  // "@preset/", so it is sent a preset name ("truth" unless ORPROXY_PRESET says
  // otherwise), and stream:false so the reply is one normal envelope.
  //
  // Declared under unsafe.bindings, the same way this deployment already runs
  // it. A services entry is checked against the account at deploy time and a
  // binding to a Worker that is not there fails the whole deploy, so the shape
  // that is known to work is the one kept here.
  //
  // OCODE (the OpenCode harness) is not bound in this account: /health reports
  // ocode:false and worker.js simply skips it, moving down the search chain.
  // Add it back under "services" once that Worker exists there.
  "unsafe": {
    "bindings": [
      {
        "name": "ORPROXY",
        "type": "service",
        "service": "orproxy",
        "environment": "production"
      }
    ]
  }
  // When the ranking admin Worker exists, add it the same way and the
  // approve/list calls are handed to it:
  //   { "binding": "ADMIN", "service": "cods-admin" }
}
