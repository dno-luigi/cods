{
  "name": "cards",
  "main": "worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2025-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/chat",
      "/chat/*",
      "/openrouter-preset",
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "4a9bfbffb4d440cba86badc508e2045a"
    }
  ],
  "routes": [
    {
      "pattern": "ai.nspired.cc",
      "custom_domain": true
    }
  ]
}